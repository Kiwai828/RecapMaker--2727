{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recapmaker--2727",
  "main": "cloudflare/src/entry.py",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "limits": {
    "cpu_ms": 10
  },
  "vars": {
    "APP_NAME": "VoiceRecap Cloudflare API",
    "JWT_ACCESS_TTL_SECONDS": "900",
    "JWT_REFRESH_TTL_SECONDS": "2592000",
    "GEMINI_MODELS": "gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro",
    "GEMINI_MAX_AUDIO_BYTES": "150000000",
    "QUEUE_MAX_DEPTH": "500",
    "FREE_DAILY_JOB_LIMIT": "3",
    "ADMIN_EMAIL": "admin@example.com",
    "MODAL_TTS_URL": "https://kouwuq--voxcpm2-tts-voxcpm2model-tts.modal.run",
    "MODAL_CLONE_URL": "https://kouwuq--voxcpm2-tts-voxcpm2model-clone.modal.run",
    "MODAL_ULTIMATE_CLONE_URL": "https://kouwuq--voxcpm2-tts-voxcpm2model-clone-ultimate.modal.run",
    "MODAL_HEALTH_URL": "https://kouwuq--voxcpm2-tts-voxcpm2model-health.modal.run"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voicerecap-db",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "voicerecap-media" },
    { "binding": "BACKUPS", "bucket_name": "voicerecap-backups" }
  ],
  "queues": {
    "producers": [{ "binding": "JOB_QUEUE", "queue": "voicerecap-jobs" }],
    "consumers": [{
      "queue": "voicerecap-jobs",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 3,
      "dead_letter_queue": "voicerecap-dead-letter"
    }]
  },
  "secrets": {
    "required": ["JWT_SECRET", "ADMIN_PASSWORD"]
  }
}
